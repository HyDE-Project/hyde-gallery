$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf

$SDDM_THEME=MacOS
$GTK_THEME = MacOS
$ICON_THEME =MacOS
$CURSOR_THEME=MacOS-Cursor

# Pair the menu-bar layout with macos.css on theme updates (HyDE #2089).
$WAYBAR_LAYOUT = macos

exec = gsettings set org.gnome.desktop.interface icon-theme '$ICON_THEME'
exec = gsettings set org.gnome.desktop.interface gtk-theme '$GTK_THEME'
exec = gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# // You can use the commands below or use the HyDE CLI to set the cursor globally
# exec = gsettings set org.gnome.desktop.interface cursor-theme '$CURSOR_THEME'
# exec = gsettings set org.gnome.desktop.interface cursor-size 20
# exec = hyprctl setcursor MacOS-Cursor 20
exec = Hyde cursor theme '$CURSOR_THEME' size 30

# // Set the sddm theme here
exec = Hyde sddm set $SDDM_THEME

general {
    gaps_in = 4
    gaps_out = 10
    border_size = 1
    col.active_border = rgba(0A84FFFF)
    col.inactive_border = rgba(3A3A3C99)
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(0A84FFFF)
    col.border_inactive = rgba(3A3A3C99)
    col.border_locked_active = rgba(0A84FFFF)
    col.border_locked_inactive = rgba(3A3A3C99)
}


decoration {
    rounding = 9
    # Keep content windows opaque; translucency belongs to functional surfaces like Waybar.
    active_opacity = 1.0
    inactive_opacity = 1.0

    shadow {
        enabled = true
        ignore_window = true
        offset = 0 0
        range = 15
        render_power = 1
        color = 0x66000000
    }

    blur {
        enabled = yes
        size = 4
        passes = 4
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
}

blurls = waybar
